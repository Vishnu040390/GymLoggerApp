{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "Seed": {
    "ReferenceData": true,
    "DemoData": false
  },
  "Media": {
    "RootPath": "App_Data/media",
    "RequestPath": "/media"
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 20
  }
}
